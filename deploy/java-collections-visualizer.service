[Unit]
Description=Java Collections Visualizer API
After=network.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=jcv
Group=jcv
WorkingDirectory=/opt/java-collections-visualizer
EnvironmentFile=/etc/java-collections-visualizer.env
ExecStart=/usr/bin/java -Xms64m -Xmx256m -Xss512k -XX:MaxMetaspaceSize=128m -XX:ReservedCodeCacheSize=64m -XX:MaxDirectMemorySize=32m -XX:ActiveProcessorCount=2 -XX:+ExitOnOutOfMemoryError -jar /opt/java-collections-visualizer/current.jar
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
SuccessExitStatus=143
MemoryHigh=384M
MemoryMax=512M
MemorySwapMax=64M
CPUQuota=100%
CPUWeight=20
TasksMax=96
LimitNOFILE=4096
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SyslogIdentifier=java-collections-visualizer

[Install]
WantedBy=multi-user.target
