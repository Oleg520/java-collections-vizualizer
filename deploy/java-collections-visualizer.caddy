jcv-api.135-106-208-51.sslip.io {
	request_body {
		max_size 32KB
	}
	# Diagnostics use a separate loopback listener and have no public route.
	@diagnostics path /actuator /actuator/*
	respond @diagnostics 404
	header X-Content-Type-Options nosniff
	reverse_proxy 127.0.0.1:18082 {
		header_up X-JCV-Client-IP {remote_host}
	}
}
