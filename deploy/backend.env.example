SERVER_ADDRESS=127.0.0.1
PORT=18082
HTTP_THREADS=4
ALLOW_FULL_TRACE=false
MAX_SESSIONS=32
# 0 derives min(32, max(1, MAX_SESSIONS / 4)); here the effective cap is 8.
MAX_SESSIONS_PER_CLIENT=0
SESSION_CREATE_RATE_LIMIT=6
WORK_RATE_LIMIT=120
RATE_WINDOW_SECONDS=60
MAX_TRACKED_CLIENTS=4096
MAX_CONCURRENT_WORK=2
MAX_CONCURRENT_WORK_PER_CLIENT=1
# Apply together with this repository's Caddy header_up rule after review.
TRUSTED_PROXIES=127.0.0.1,::1
SESSION_TTL_SECONDS=1800
# Exact published Netlify origin, without trailing slash. Never use a wildcard.
ALLOWED_ORIGINS=https://java-collections-visualizer.netlify.app
