# Illustrative template, not the production environment. Do not apply unchanged.
SERVER_ADDRESS=127.0.0.1
PORT=8080
# Separate loopback diagnostics listener; never add it to Caddy upstreams.
MANAGEMENT_PORT=18083
HTTP_THREADS=8
ALLOW_FULL_TRACE=false
MAX_SESSIONS=128
# 0 derives min(32, max(1, MAX_SESSIONS / 4)); here the effective cap is 32.
MAX_SESSIONS_PER_CLIENT=0
SESSION_CREATE_RATE_LIMIT=30
WORK_RATE_LIMIT=600
RATE_WINDOW_SECONDS=60
MAX_TRACKED_CLIENTS=4096
MAX_CONCURRENT_WORK=2
MAX_CONCURRENT_WORK_PER_CLIENT=1
# Apply with the trusted-proxy header overwrite contract in docs/API_SECURITY.md.
TRUSTED_PROXIES=127.0.0.1,::1
SESSION_TTL_SECONDS=1800
# Exact deployment origins, without trailing slash. Preserve required legacy origins during a hosting migration.
# Preview origins are not implicitly trusted. Never use a wildcard.
ALLOWED_ORIGINS=https://frontend.example.org,https://legacy-frontend.example.org
