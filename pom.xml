<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-parent</artifactId><version>3.5.16</version><relativePath/></parent>
  <groupId>dev.collectionsviz</groupId><artifactId>collections-visualizer</artifactId><version>0.0.0-SNAPSHOT</version><packaging>pom</packaging>
  <properties><java.version>21</java.version><project.build.sourceEncoding>UTF-8</project.build.sourceEncoding></properties>
  <modules><module>core</module><module>backend</module></modules>
  <build><plugins><plugin>
    <groupId>org.codehaus.mojo</groupId><artifactId>exec-maven-plugin</artifactId><version>3.6.4</version>
    <!-- Validate the reactor once, without resolving unbuilt module dependencies. -->
    <inherited>false</inherited>
    <executions><execution>
      <id>validate-git-version</id><phase>validate</phase><goals><goal>exec</goal></goals>
      <configuration>
        <executable>sh</executable>
        <arguments>
          <argument>${maven.multiModuleProjectDirectory}/scripts/git-version.sh</argument>
          <argument>--check-maven</argument><argument>${project.version}</argument>
        </arguments>
      </configuration>
    </execution></executions>
  </plugin></plugins></build>
  <profiles>
    <!-- Explicit tooling profile: ordinary builds do not need an IDE installation. -->
    <profile>
      <id>java-format</id>
      <activation><property><name>java.format</name></property></activation>
      <build><plugins><plugin>
        <groupId>org.codehaus.mojo</groupId><artifactId>exec-maven-plugin</artifactId>
        <inherited>false</inherited>
        <executions>
          <execution>
            <id>check-java-formatting</id>
            <phase>validate</phase>
            <goals><goal>exec</goal></goals>
            <configuration>
              <executable>python3</executable>
              <arguments>
                <argument>${maven.multiModuleProjectDirectory}/scripts/java-format.py</argument>
                <argument>${java.format}</argument>
              </arguments>
            </configuration>
          </execution>
        </executions>
      </plugin></plugins></build>
    </profile>
  </profiles>
</project>
