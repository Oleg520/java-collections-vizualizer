<configuration xmlns="https://github.com/qoomon/maven-git-versioning-extension">
  <!-- Only tags on HEAD, including an attached branch. Never use git describe. -->
  <refs considerTagsOnBranches="true">
    <ref type="tag">
      <pattern>(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)</pattern>
      <version>${ref}</version>
    </ref>
  </refs>
  <rev>
    <version>0.0.0-${commit}-SNAPSHOT</version>
  </rev>
</configuration>
