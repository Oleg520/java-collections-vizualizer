root = true

# Java only: frontend formatting remains owned by Prettier.
[*.java]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4
tab_width = 4
ij_java_continuation_indent_size = 8
# A wrapping guide, not a hard limit for literals, comments or declarations.
max_line_length = 120
